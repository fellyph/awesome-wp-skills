{
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "1152px", "wideSize": "1152px" },
    "color": { "defaultPalette": false, "palette": [
      { "slug": "paper", "name": "Paper", "color": "#f4f2eb" },
      { "slug": "ink", "name": "Ink", "color": "#213a31" },
      { "slug": "moss", "name": "Moss", "color": "#dce6db" }
    ] },
    "typography": {
      "fontFamilies": [
        { "slug": "editorial", "name": "Georgia", "fontFamily": "Georgia, 'Times New Roman', serif" },
        { "slug": "body", "name": "Trebuchet MS", "fontFamily": "'Trebuchet MS', sans-serif" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "14px" },
        { "slug": "body", "name": "Body", "size": "18px" },
        { "slug": "large", "name": "Large", "size": "30px" }
      ]
    },
    "spacing": { "units": ["px", "rem", "%", "vw"] }
  },
  "styles": {
    "color": { "background": "var:preset|color|paper", "text": "var:preset|color|ink" },
    "spacing": { "blockGap": "24px" },
    "typography": { "fontFamily": "var:preset|font-family|body", "fontSize": "18px", "lineHeight": "1.6" },
    "elements": {
      "heading": { "typography": { "fontFamily": "var:preset|font-family|editorial", "fontWeight": "400", "lineHeight": "1.08", "letterSpacing": "-0.04em" } },
      "h1": { "typography": { "fontSize": "clamp(54px, 6.875vw, 88px)" } },
      "h2": { "typography": { "fontSize": "clamp(36px, 4.063vw, 52px)" } },
      "h3": { "typography": { "fontSize": "30px", "letterSpacing": "-0.015em" } },
      "link": { "color": { "text": "var:preset|color|ink" } },
      "button": {
        "color": { "background": "var:preset|color|ink", "text": "var:preset|color|paper" },
        "border": { "radius": "0" },
        "typography": { "fontFamily": "var:preset|font-family|body", "fontSize": "16px", "fontWeight": "700", "lineHeight": "1.5" },
        "spacing": { "padding": { "top": "18px", "right": "26px", "bottom": "18px", "left": "26px" } }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
