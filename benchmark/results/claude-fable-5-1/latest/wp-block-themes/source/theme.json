{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1160px",
      "wideSize": "1360px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "paper", "name": "Paper", "color": "#f4f2eb" },
        { "slug": "ink", "name": "Ink", "color": "#213a31" },
        { "slug": "moss", "name": "Moss", "color": "#dce6db" },
        { "slug": "white", "name": "White", "color": "#ffffff" },
        { "slug": "line", "name": "Line", "color": "#d3d1c9" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw"],
      "spacingSizes": [
        { "slug": "20", "name": "1", "size": "0.5rem" },
        { "slug": "30", "name": "2", "size": "1rem" },
        { "slug": "40", "name": "3", "size": "1.5rem" },
        { "slug": "50", "name": "4", "size": "2.5rem" },
        { "slug": "60", "name": "5", "size": "4rem" },
        { "slug": "70", "name": "6", "size": "6rem" }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "editorial",
          "name": "Editorial (Georgia)",
          "fontFamily": "Georgia, 'Times New Roman', serif"
        },
        {
          "slug": "body",
          "name": "Body (Trebuchet MS)",
          "fontFamily": "'Trebuchet MS', 'Lucida Grande', 'Lucida Sans Unicode', sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "x-small", "name": "Extra small", "size": "0.75rem", "fluid": false },
        { "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": false },
        { "slug": "medium", "name": "Medium", "size": "1.125rem", "fluid": false },
        { "slug": "large", "name": "Large", "size": "1.5rem", "fluid": { "min": "1.35rem", "max": "1.625rem" } },
        { "slug": "x-large", "name": "Extra large", "size": "2.5rem", "fluid": { "min": "2rem", "max": "3rem" } },
        { "slug": "xx-large", "name": "Huge", "size": "4.5rem", "fluid": { "min": "2.75rem", "max": "5.5rem" } }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "padding": {
        "top": "0",
        "right": "var:preset|spacing|40",
        "bottom": "0",
        "left": "var:preset|spacing|40"
      },
      "blockGap": "1.25rem"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|editorial",
          "fontWeight": "400",
          "lineHeight": "1.1",
          "letterSpacing": "-0.01em"
        },
        "color": { "text": "var:preset|color|ink" }
      },
      "h1": { "typography": { "fontSize": "var:preset|font-size|xx-large", "lineHeight": "1.02" } },
      "h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
      "h3": { "typography": { "fontSize": "var:preset|font-size|large" } },
      "link": {
        "color": { "text": "var:preset|color|ink" },
        ":hover": { "typography": { "textDecoration": "none" } },
        ":focus": { "outline": { "width": "2px", "style": "solid", "color": "var:preset|color|ink", "offset": "3px" } }
      },
      "button": {
        "color": {
          "background": "var:preset|color|ink",
          "text": "var:preset|color|white"
        },
        "border": { "radius": "0", "width": "0" },
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "700"
        },
        "spacing": {
          "padding": { "top": "1rem", "bottom": "1rem", "left": "1.75rem", "right": "1.75rem" }
        },
        ":hover": {
          "color": { "background": "#15271f", "text": "var:preset|color|white" }
        },
        ":focus": {
          "color": { "background": "#15271f", "text": "var:preset|color|white" },
          "outline": { "width": "2px", "style": "solid", "color": "var:preset|color|ink", "offset": "3px" }
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": { "fontSize": "var:preset|font-size|small" }
      },
      "core/quote": {
        "typography": {
          "fontFamily": "var:preset|font-family|editorial",
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.25"
        },
        "border": { "width": "0" },
        "spacing": { "padding": { "left": "0" }, "margin": { "top": "1.5rem", "bottom": "0" } }
      },
      "core/details": {
        "typography": { "fontSize": "var:preset|font-size|medium" },
        "border": { "top": { "width": "1px", "style": "solid", "color": "var:preset|color|line" } },
        "spacing": { "padding": { "top": "1.25rem", "bottom": "1.25rem" } }
      },
      "core/separator": {
        "color": { "text": "var:preset|color|line" },
        "border": { "width": "0 0 1px 0", "style": "solid" }
      },
      "core/image": {
        "border": { "radius": "0" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": []
}
